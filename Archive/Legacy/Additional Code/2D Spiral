# ==========================================
# 2. Prime-Power & von Mangoldt Generator
# ==========================================
def generate_horizon_terms(num_terms=S_TOTAL):
    """
    Generates the first `num_terms` prime powers (p^k) ordered by magnitude,
    along with their corresponding von Mangoldt weights Lambda(n) = ln(p).
    For S_total = 114, the horizon boundary lands at n_114 = 499.
    """
    max_search = 1000
    is_prime = [True] * (max_search + 1)
    primes = []
    
    for p in range(2, max_search + 1):
        if is_prime[p]:
            primes.append(p)
            for multiple in range(p * p, max_search + 1, p):
                is_prime[multiple] = False

    terms = []
    for p in primes:
        pk = p
        ln_p = np.log(p)
        while pk <= max_search:
            terms.append((pk, ln_p))
            pk *= p

    # Sort strictly by integer magnitude n = p^k and slice to the 114-step horizon
    terms.sort(key=lambda x: x[0])
    horizon_slice = terms[:num_terms]
    
    ns = np.array([t[0] for t in horizon_slice], dtype=float)
    lambdas = np.array([t[1] for t in horizon_slice], dtype=float)
    return ns, lambdas


# ==========================================
# 3. Cesaro-Windowed Resonance & Spiral Math
# ==========================================
def compute_weights(ns, lambdas, mode="cesaro"):
    """
    Computes the spectral weights for each prime-power harmonic.
    - 'raw': Unsmoothed Dirichlet truncation (Lambda(n) / sqrt(n))
    - 'cesaro': Logarithmic Cesaro-Riesz window W(n) = (1 - ln(n)/ln(N_H))^gamma
    """
    base_weights = lambdas / np.sqrt(ns)
    if mode == "raw":
        return base_weights
    
    # Use N_H + 1 so the final prime-power term remains inside the window.
    n_horizon = ns[-1] + 1.0
    window = (1.0 - (np.log(ns) / np.log(n_horizon))) ** GAMMA
    return base_weights * window


def resonance_derivative(E, ns, weights, phase_correction=0.0):
    """
    Evaluates the real stationary resonance slope condition:
    G(E) = Re[ Z_total(E) ] = sum_{k=1}^{114} W(n_k) * (Lambda(n_k) / sqrt(n_k)) * cos(E * ln(n_k) + phi)
    """
    E_arr = np.atleast_1d(E)
    log_ns = np.log(ns)
    phases = np.outer(E_arr, log_ns) + phase_correction
    vals = np.cos(phases) @ weights
    return vals if np.ndim(E) > 0 else vals[0]


def compute_complex_spiral(E, ns, weights):
    """
    Computes the cumulative 2D complex phase trajectory across the 114 steps:
    Z(K) = sum_{k=1}^{K} W(n_k) * (Lambda(n_k) / sqrt(n_k)) * exp(i * E * ln(n_k))
    
    At a true stationary resonance height E = t_i, the real derivative projection
    Re[Z(114)] vanishes (crosses the vertical imaginary axis Re = 0).
    """
    phases = E * np.log(ns)
    step_vectors = weights * np.exp(1j * phases)
    # Include the origin (0 + 0j) as the starting seed point of the trajectory
    cumulative_spiral = np.concatenate([[0.0 + 0.0j], np.cumsum(step_vectors)])
    return cumulative_spiral


def find_stationary_root(target_E, ns, weights, search_radius=0.35, steps=2000):
    """
    Locates the stationary zero crossing closest to `target_E` using
    high-resolution grid bracketing followed by linear secant interpolation.
    """
    e_grid = np.linspace(target_E - search_radius, target_E + search_radius, steps)
    g_vals = resonance_derivative(e_grid, ns, weights)
    
    best_root = target_E
    min_dist = float('inf')
    
    for i in range(len(e_grid) - 1):
        if g_vals[i] * g_vals[i + 1] <= 0:
            root = e_grid[i] - g_vals[i] * (e_grid[i + 1] - e_grid[i]) / (g_vals[i + 1] - g_vals[i])
            dist = abs(root - target_E)
            if dist < min_dist:
                min_dist = dist
                best_root = root
                
    return best_root


