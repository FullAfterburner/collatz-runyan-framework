import numpy as np
from scipy.signal import find_peaks
from scipy.special import digamma
from mpmath import siegelz, findroot

def get_von_mangoldt(N):
    lam = np.zeros(N + 1)
    is_prime = np.ones(N + 1, dtype=bool)
    is_prime[:2] = False
    for p in range(2, N + 1):
        if is_prime[p]:
            if p * p <= N:
                is_prime[p*p::p] = False
            pk, ln_p = p, np.log(p)
            while pk <= N:
                lam[pk] = ln_p
                pk *= p
    return lam

# Stage 1: Locate approximate peaks via refined prime-power sum
N = 10000
lam = get_von_mangoldt(N)
n_vals = np.arange(2, N + 1)
ln_n = np.log(n_vals)
weights = (lam[2:] / np.sqrt(n_vals)) * (1.0 - ln_n / np.log(N))

t_grid = np.linspace(10.0, 50.0, 20000)
smooth = (1.0 / (2.0 * np.pi)) * (np.log(np.pi) - np.real(digamma(0.25 + 0.5j * t_grid)))
osc = -(1.0 / np.pi) * np.cos(np.outer(t_grid, ln_n)) @ weights
F_t = smooth + osc

peaks, _ = find_peaks(F_t, height=0.5)
approx_zeros = t_grid[peaks]

# Stage 2: Lock onto exact zeros (15+ digits) using Riemann-Siegel Z(t)
for idx, t_guess in enumerate(approx_zeros, 1):
    exact_zero = findroot(siegelz, t_guess)
    print(f"Zero {idx:2d} | Prime Peak: {t_guess:.6f} | Exact: {float(exact_zero):.15f}")
