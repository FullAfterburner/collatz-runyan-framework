def find_diophantine_solutions(limit):
    solutions = []
    print(f"{'n':>5} | {'T_n':>8} | {'m':>5} | {'T_m':>8} | Verification (3*T_n + 1 = T_m)")
    print("-" * 65)
    
    for n in range(limit):
        Y = 2 * n + 1
        X_squared = 3 * (Y ** 2) + 6
        X = int(X_squared ** 0.5)
        
        # Verify if X is a perfect square and satisfies the Pell equation
        if X * X == X_squared:
            # Check if X is odd so m is an integer
            if (X - 1) % 2 == 0:
                m = (X - 1) // 2
                t_n = (n * (n + 1)) // 2
                t_m = (m * (m + 1)) // 2
                solutions.append((n, m, t_n, t_m))
                print(f"{n:>5} | {t_n:>8} | {m:>5} | {t_m:>8} | 3*({t_n}) + 1 = {t_m}")
    return solutions

def trace_collatz_trajectory(start_val):
    path = [start_val]
    current = start_val
    while current > 1:
        if current % 2 == 0:
            current = current // 2
        else:
            current = 3 * current + 1
        path.append(current)
    return path

# 1. Generate the first 5 valid integer solution pairs
print("--- DIOPHANTINE SOLUTIONS GENERATED ---")
solutions = find_diophantine_solutions(limit=1000)

# 2. Trace the full Collatz path starting from the T_m = 136 discovery
print("\n--- COLLATZ TRAJECTORY FOR T_16 (136) ---")
collatz_path = trace_collatz_trajectory(136)
print(" -> ".join(map(str, collatz_path)))
